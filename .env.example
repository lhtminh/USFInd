# OpenRouter (free signup at https://openrouter.ai → keys)
OPENROUTER_API_KEY=
# Optional model overrides — default is one free omni-modal reasoning model
# for both tiers:
#   OPENROUTER_FLASH_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
#   OPENROUTER_PRO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Postgres (Neon)
DATABASE_URL=

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis cache
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible) object storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=usfind-images
R2_PUBLIC_URL=

# Signed-cookie session secret (use a long random string in production)
SESSION_SECRET=

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=local
