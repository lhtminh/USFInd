# OpenRouter (free signup at https://openrouter.ai → keys)
OPENROUTER_API_KEY=
# Optional overrides — defaults are free vision-capable models:
#   OPENROUTER_FLASH_MODEL=google/gemini-2.0-flash-exp:free
#   OPENROUTER_PRO_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# Postgres (Neon)
DATABASE_URL=

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis cache
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible) object storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=usfind-images
R2_PUBLIC_URL=

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=local
