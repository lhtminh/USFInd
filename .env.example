# Google Gemini
GEMINI_API_KEY=

# Postgres (Neon)
DATABASE_URL=

# Qdrant vector DB
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis cache
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible) object storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=usfind-images
R2_PUBLIC_URL=

# Runtime
LOG_LEVEL=INFO
ENVIRONMENT=local
